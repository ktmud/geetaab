{
  "name": "geetaab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Listen to a song, get a beginner-friendly guitar tab, and practice it karaoke-style.",
  "scripts": {
    "dev": "vite",
    "build": "npm run privacy && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "smoke": "vite-node scripts/smoke.mjs",
    "privacy": "vite-node scripts/privacy-page.mjs --write",
    "privacy:check": "vite-node scripts/privacy-page.mjs --check"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
